# Deployment environment for Hive Online.
#
# deploy.ps1 creates this file on the host and merges the managed keys on every
# deploy. It refreshes HIVE_PORT, PUBLIC_URL and TZ, and adds any mail keys that
# are missing, but it never overwrites values you set for secrets.
#
# Copy to /home/pi/portainer_data/hive/.env and edit there. Never commit a real
# .env.

HIVE_PORT=8085
PUBLIC_URL=http://homebridge.local:8085
TZ=Europe/London

# --- Mail -------------------------------------------------------------------
# MAIL_MODE: smtp | zeptomail | log
# smtp     -> deliver through SMTP_HOST/SMTP_PORT (mailpit by default)
# zeptomail-> deliver through the ZeptoMail HTTP API using ZEPTOMAIL_TOKEN
# log      -> send nothing; print verification links to the container log
MAIL_MODE=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_ALLOW_NO_AUTH=true
SMTP_FROM=admin@example.com

# Only needed for an authenticated SMTP relay.
# SMTP_USER=
# SMTP_PASS=

# Only needed when MAIL_MODE=zeptomail. Keep the real token out of source
# control. Either the bare key or the full "Zoho-enczapikey ..." value works.
ZEPTOMAIL_API_URL=https://api.zeptomail.eu/v1.1/email
ZEPTOMAIL_TOKEN=

# --- Computer opponent (Ollama) ---------------------------------------------
# Adds a "Play HiveMind" single-player game. The bot is a private, casual
# opponent and never affects ratings or the public lobby.
# OLLAMA_ENABLED=false turns the language model off and uses the built-in
# heuristic instead. Set OLLAMA_URL to any reachable Ollama server.
OLLAMA_ENABLED=true
OLLAMA_URL=http://192.168.1.148:11434
OLLAMA_MODEL=llama3.1:8b
# A warm model replies in under a second. Raise this if your model is slow or
# frequently cold; a timeout falls back to the heuristic move.
OLLAMA_TIMEOUT_MS=12000
# Cosmetic pause before the computer moves, so replies feel deliberate.
BOT_MIN_DELAY_MS=900
# Difficulty: auto scales with the player's rating (novice < 1100, casual,
# skilled 1200+, expert 1350+, master 1500+). Set a level to pin every new
# game, or leave auto and let players pick in the lobby.
BOT_DIFFICULTY=auto

# Web inbox for the bundled Mailpit service.
MAILPIT_UI_PORT=8025
